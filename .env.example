# Скопіюйте у .env і заповніть значення.
# DJANGO_SETTINGS_MODULE: config.settings.dev (за замовчуванням у manage.py) або config.settings.prod

SECRET_KEY=change-me
ALLOWED_HOSTS=localhost,127.0.0.1
# Origins фронтенду; у dev за замовчуванням localhost:3000 і localhost:5173
#CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# PostgreSQL (у docker-compose POSTGRES_HOST перевизначається на "db")
POSTGRES_DB=hrm_db
POSTGRES_USER=hrm_user
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Redis-кеш (у docker-compose перевизначається на redis://redis:6379/0);
# без REDIS_URL використовується кеш у пам'яті процесу
REDIS_URL=redis://localhost:6379/0

# pgAdmin (docker-compose)
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=change-me

# AWS S3 — тільки для prod (файли працівників); у dev файли лежать у media/.
# Доступ — лише через IAM-роль (instance profile / ECS task role / IRSA),
# статичні ключі не використовуються.
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=

# OpenAI
OPENAI_API_KEY=
