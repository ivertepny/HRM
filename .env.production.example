# .env для docker-compose.server.yml — шаблон, без справжніх секретів.
# На сервері: /www/hrm/.env, chmod 600, ніколи не в git.
# Секрети генерувати так:
#   python3 -c "import secrets; print(secrets.token_urlsafe(50))"
#
# Цей файл читає і сам compose (${...} у docker-compose.server.yml), і
# контейнер api (env_file). Значення з `environment:` у compose
# (DJANGO_SETTINGS_MODULE, POSTGRES_HOST, REDIS_URL) мають пріоритет.
#
# AWS-ключів тут бути не повинно: prod.py з ними не стартує.

# --- Django ---------------------------------------------------------------------
# Довгий випадковий секрет. Зміна пізніше розлогінить усіх (ним підписані JWT).
SECRET_KEY=
# До Django ходить лише Next (http://api:8000) і healthcheck — домен сюди не
# доходить, бо nginx шле весь трафік браузера в Next.
ALLOWED_HOSTS=api
# Для форм Django з CSRF (адмінка через SSH-тунель); API працює на JWT
CSRF_TRUSTED_ORIGINS=https://hrm.example.com
# HSTS у секундах — те саме значення, що в nginx/nginx.conf (саме звідти
# заголовок іде в браузер). Почати з 3600; коли HTTPS кілька днів працює —
# 31536000. Зменшення діє лише після спливу старого max-age.
SECURE_HSTS_SECONDS=3600
TIME_ZONE=Europe/Kyiv

# --- PostgreSQL -------------------------------------------------------------------
# Контейнер db читає їх лише при першому створенні volume; змінити пароль
# пізніше — ще й ALTER ROLE усередині контейнера.
POSTGRES_DB=hrm
POSTGRES_USER=hrm
POSTGRES_PASSWORD=

# --- Sentry (необов'язково) --------------------------------------------------------
# Порожньо — звіти про помилки вимкнені. Тіла запитів, локальні змінні й дані
# користувачів у Sentry не йдуть (apps/core/sentry.py). Release — git SHA.
SENTRY_DSN=
SENTRY_ENVIRONMENT=production

# --- Ліміти (необов'язково; за замовчуванням — у config/settings/base.py) -----------
# Спроб входу на один email; повідомлень AI-асистенту на користувача
#LOGIN_RATE=10/hour
#AI_CHAT_RATE=10/min
#AI_CHAT_DAILY_RATE=200/day

# --- AI-асистент (необов'язково) -------------------------------------------------
# Порожньо — асистент відповідає 503. Усе, що пишуть у чат, іде в OpenAI.
OPENAI_API_KEY=
